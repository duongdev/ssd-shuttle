				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Shuttle - Offload to SSD
# Finder Quick Action for offloading directories

SHUTTLE="$HOME/bin/shuttle"

# Function to show notification
notify() {
    osascript -e "display notification \"$2\" with title \"$1\" sound name \"Glass\""
}

# Function to show error dialog
show_error() {
    osascript -e "display dialog \"$1\" with title \"Shuttle Error\" buttons {\"OK\"} default button \"OK\" with icon stop"
}

# Check if shuttle exists
if [[ ! -x "$SHUTTLE" ]]; then
    show_error "Shuttle CLI not found. Please install shuttle first."
    exit 1
fi

# Process each selected folder
for folder in "$@"; do
    name=$(basename "$folder")

    # Check if it's a symlink (already offloaded)
    if [[ -L "$folder" ]]; then
        show_error "$name is already offloaded."
        continue
    fi

    # Check if it's a directory
    if [[ ! -d "$folder" ]]; then
        show_error "$name is not a directory."
        continue
    fi

    # Run shuttle offload
    output=$(CONFIRM=false "$SHUTTLE" offload "$folder" 2&gt;&amp;1)
    exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        notify "Shuttle" "Offloaded: $name"
    else
        # Strip ANSI codes
        clean=$(echo "$output" | LC_ALL=C tr -d '\033' | tr -d '[]' | head -1)
        show_error "Failed: $clean"
    fi
done</string>
